# Copy to .env.local and supply newly rotated credentials. Never commit .env.local.
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated additional trusted frontend origins.
# ALLOWED_ORIGINS=https://app.example.com

# Use either the base64 service-account JSON or all three individual fields.
FIREBASE_ADMIN_SDK_CONFIG_BASE64=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Firebase Web API key used by the server for Firebase Authentication REST calls.
# This is not an Admin credential, but should still be restricted in Google Cloud.
FIREBASE_WEB_API_KEY=

# Optional: revoke Firebase refresh tokens on logout.
SESSION_REVOKE_ON_LOGOUT=false

# Initial admin bootstrap only; used by `npm run seed:admin`.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_PIC=Platform Admin

# One account per role; used by `npm run seed:accounts`.
# Leave the passwords empty to use the built-in defaults printed by the script.
SEED_DONOR_EMAIL=donor@panganloop.id
SEED_DONOR_PASSWORD=
SEED_RECIPIENT_EMAIL=penerima@panganloop.id
SEED_RECIPIENT_PASSWORD=
SEED_ADMIN_EMAIL=admin@panganloop.id
SEED_ADMIN_PASSWORD=
